{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar C++ en RAM",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "${workspaceFolder}/src/main.cpp",
                "-o",
                "/tmp/app_cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
